# SyncSpace Server Configuration
NODE_ENV=development
PORT=4000
HOST=127.0.0.1

# Database Configuration (Milestone 2)
DATABASE_URL=postgres://syncspace:syncspace_dev_password@127.0.0.1:5432/syncspace_dev
DB_POOL_MAX=10

# Test Database Configuration (Required for integration tests; must end in _test)
TEST_DATABASE_URL=postgres://syncspace:syncspace_dev_password@127.0.0.1:5432/syncspace_test

# Authentication Configuration (Milestone 3 - Better Auth)
BETTER_AUTH_SECRET=development_better_auth_secret_must_be_32_characters_minimum!
BETTER_AUTH_URL=http://127.0.0.1:4000

